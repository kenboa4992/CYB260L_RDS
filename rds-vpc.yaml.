AWSTemplateFormatVersion: '2010-09-09'
Description: This template creates an RDS instance within a VPC.

Resources:
  RdsInstance:
    Type: AWS::RDS::DBInstance
    Properties:
      VPCSecurityGroups:
        - kenboa4992  # Replace with your actual security group ID without angle brackets
      AllocatedStorage: '5'
      DBInstanceClass: db.t3.micro
      DBInstanceIdentifier: playground-db
      Engine: MySQL
      MasterUsername: Admin
      MasterUserPassword: CloudAcademy123!
